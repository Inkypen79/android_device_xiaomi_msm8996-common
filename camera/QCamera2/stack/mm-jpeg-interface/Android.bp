cc_library_shared {
    name: "libmmjpeg_interface",
    vendor: true,
    compile_multilib: "32",

    cflags: [
        "-D_ANDROID_",
        "-DQCAMERA_REDEFINE_LOG",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-compound-token-split-by-macro",
        "-DUSE_ION",
        "-DMM_JPEG_CONCURRENT_SESSIONS_COUNT=1",
        "-DMM_JPEG_USE_PIPELINE",
        "-DSYSTEM_HEADER_PREFIX=sys",
    ],

    header_libs: [
        "camera_common_headers",
        "generated_kernel_headers",
        "libmmcamera_interface_headers",
        "libqexif_headers",
        "libqomx_core_headers",
        "libutils_headers",
        "media_plugin_headers",
    ],

    local_include_dirs: [
        "inc",
    ],

    srcs: [
        "src/mm_jpeg_queue.c",
        "src/mm_jpeg_exif.c",
        "src/mm_jpeg.c",
        "src/mm_jpeg_interface.c",
        "src/mm_jpeg_ionbuf.c",
        "src/mm_jpegdec_interface.c",
        "src/mm_jpegdec.c",
        "src/mm_jpeg_mpo_composer.c",
    ],

    shared_libs: [
        "libdl",
        "libcutils",
        "liblog",
        "libqomx_core",
        "libmmcamera_interface",
    ],
}
